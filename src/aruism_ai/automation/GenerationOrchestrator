# Aruism AI Project - Multi-Axis Hierarchy Updater
# バージョン: 1.0
# 目的: AI生成の多軸階層JSONを解釈し、Neo4jに永続化する
######################################################################
import os
import sys
import json
import logging
import argparse
from typing import List, Dict, Any

# --- プロジェクトのパス設定 ---
PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.append(PROJECT_ROOT)

from aruism_ai.ontology.db_manager import GraphDBManager
from aruism_ai.ontology.models import AxisNode, LevelNode

class HierarchyUpdater:
    def __init__(self, db_manager: GraphDBManager, concept_id: str, json_data: Dict[str, Any]):
        self.db = db_manager
        self.root_concept_id = concept_id
        self.data = json_data
        self.nodes_to_create: Dict[str, List[Dict]] = {"Axis": [], "Level": []}
        self.rels_to_create: Dict[str, List[Dict]] = {"CONCEPT_HAS_AXIS": [], "AXIS_HAS_LEVEL": []}

    def parse_and_transform(self):
        """JSONデータを解析し、DB格納用のオブジェクトに変換する"""
        logging.info("JSONデータの解析と変換を開始します。")

        for axis_id, axis_data in self.data.items():
            if axis_id.startswith("_"): continue

            # 1. Axisノードの準備
            axis_name = axis_data.get("_philosophical_approach", axis_id)
            self.nodes_to_create["Axis"].append(AxisNode(axis_id=axis_id, name=axis_name).to_dict())

            # 2. (Concept)-[:HAS_AXIS]->(Axis) 関連の準備
            self.rels_to_create["CONCEPT_HAS_AXIS"].append({
                "source_id": self.root_concept_id,
                "target_id": axis_id,
                "props": {}
            })

            # 3. Levelノードと (Axis)-[:HAS_LEVEL]->(Level) 関連の準備
            for concept_key, hierarchy in axis_data.items():
                if concept_key.startswith("_") or not isinstance(hierarchy, dict): continue

                concept_being_processed = self.root_concept_id # TODO: 将来的に対称ペアのIDを正しく扱う
                
                for level, details in hierarchy.items():
                    if level.startswith("_") or not isinstance(details, dict): continue

                    level_id = f"{axis_id}_{concept_being_processed}_{level}"
                    reasoning_str = json.dumps({k: v for k, v in details.items() if k.startswith("_")}, ensure_ascii=False)
                    
                    self.nodes_to_create["Level"].append(LevelNode(
                        level_id=level_id,
                        name_ja=details.get("concept", ""),
                        name_en=details.get("english", ""),
                        reasoning=reasoning_str
                    ).to_dict())

                    self.rels_to_create["AXIS_HAS_LEVEL"].append({
                        "source_id": axis_id,
                        "target_id": level_id,
                        "props": {
                            "level": int(level),
                            "concept_id": concept_being_processed
                        }
                    })
        logging.info("データの変換が完了しました。")

    def execute_update(self):
        """変換したデータをDBに書き込む"""
        logging.info("データベースの更新を開始します...")
        try:
            # Step 1: ノードの作成
            self.db.batch_merge_nodes(
                label="Axis",
                id_property="axis_id",
                node_batch=self.nodes_to_create["Axis"]
            )
            logging.info(f"{len(self.nodes_to_create['Axis'])}件のAxisノードをマージしました。")
            
            self.db.batch_merge_nodes(
                label="Level",
                id_property="level_id",
                node_batch=self.nodes_to_create["Level"]
            )
            logging.info(f"{len(self.nodes_to_create['Level'])}件のLevelノードをマージしました。")

            # Step 2: 関連の作成
            self.db.batch_merge_relationships(
                source_label="Concept", source_id_prop="concept_id",
                target_label="Axis", target_id_prop="axis_id",
                rel_type="HAS_AXIS",
                rel_batch=self.rels_to_create["CONCEPT_HAS_AXIS"]
            )
            logging.info(f"{len(self.rels_to_create['CONCEPT_HAS_AXIS'])}件のHAS_AXIS関連をマージしました。")

            self.db.batch_merge_relationships(
                source_label="Axis", source_id_prop="axis_id",
                target_label="Level", target_id_prop="level_id",
                rel_type="HAS_LEVEL",
                rel_batch=self.rels_to_create["AXIS_HAS_LEVEL"]
            )
            logging.info(f"{len(self.rels_to_create['AXIS_HAS_LEVEL'])}件のHAS_LEVEL関連をマージしました。")

            logging.info("データベースの更新が正常に完了しました。")
        except Exception as e:
            logging.error(f"データベース更新中にエラーが発生しました: {e}", exc_info=True)
            raise

if __name__ == '__main__':
    logging.basicConfig(level="INFO", format='%(asctime)s - %(levelname)s - %(message)s')

    parser = argparse.ArgumentParser(description="AI生成の多軸階層JSONをDBに永続化します。")
    parser.add_argument("concept_id", type=str, help="ルートとなるコンセプトのID (例: M0001)")
    parser.add_argument("json_file_path", type=str, help="入力となるJSONファイルのパス")
    args = parser.parse_args()

    db_manager = None
    try:
        NEO4J_PASSWORD = os.environ.get("NEO4J_PASSWORD")
        if not NEO4J_PASSWORD:
            raise ValueError("環境変数 NEO4J_PASSWORD が設定されていません。")
        
        with open(args.json_file_path, 'r', encoding='utf-8') as f:
            json_data = json.load(f)

        db_manager = GraphDBManager(uri="bolt://arism-db:7687", user="neo4j", password=NEO4J_PASSWORD)
        
        updater = HierarchyUpdater(db_manager, args.concept_id, json_data)
        updater.parse_and_transform()
        updater.execute_update()

    except FileNotFoundError:
        logging.error(f"指定されたファイルが見つかりません: {args.json_file_path}")
    except json.JSONDecodeError:
        logging.error(f"JSONの解析に失敗しました: {args.json_file_path}")
    except Exception as e:
        logging.error(f"処理中に予期せぬエラーが発生しました: {e}", exc_info=True)
    finally:
        if db_manager:
            db_manager.close()