# NVIDIA公式のPyTorchイメージをベースにする
FROM nvcr.io/nvidia/pytorch:25.03-py3

# ビルドに必要な引数
ARG DEBIAN_FRONTEND=noninteractive
ARG CUDA_ARCHS="89-real;90-real"

# システムのアップデートとビルドツールのインストール
RUN apt-get update && apt-get install -y --no-install-recommends \
    git git-lfs build-essential ccache libopenmpi-dev python3-dev && \
    rm -rf /var/lib/apt/lists/*

# ソースコードをコンテナ内にコピー
COPY . /workspace/tensorrt_llm
WORKDIR /workspace/tensorrt_llm

# Python依存関係のインストールとTensorRT-LLMのビルド
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install -r requirements.txt && \
    python3 ./scripts/build_wheel.py --cuda_architectures=${CUDA_ARCHS} --use_ccache --clean && \
    pip install ./build/tensorrt_llm*.whl

# --------------------------------------------------------
# ここからアリストAIプロジェクト固有の設定
# --------------------------------------------------------
WORKDIR /workspace/Aruism-AI-Local

COPY ./aristo_project_files/requirements.txt .
RUN pip install -r requirements.txt

COPY ./aristo_project_files/ /workspace/Aruism-AI-Local/

# デフォルトのコマンド
CMD ["tail", "-f", "/dev/null"]